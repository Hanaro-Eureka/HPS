generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Salary {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  userId        Int      @db.UnsignedInt
  amount        Int
  depositDate   DateTime @db.DateTime(0)
  depositorName String?  @db.VarChar(63)
  incomeSource  String?  @db.VarChar(63)
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "salary_ibfk_1")

  @@index([userId], map: "userId")
}

model User {
  id           Int            @id @default(autoincrement()) @db.UnsignedInt
  name         String         @db.VarChar(31)
  loginId      String         @unique(map: "loginId_UNIQUE") @db.VarChar(60)
  password     String         @db.VarChar(60)
  createdAt    DateTime       @default(now()) @db.DateTime(0)
  birthDate    String         @db.VarChar(8)
  businessCode String?        @db.VarChar(6)
  FixedExpense FixedExpense[]
  Salary       Salary[]
}

model FixedExpense {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  expenseName    String?  @db.VarChar(20)
  lastIncomeDate DateTime @default(now()) @db.DateTime(0)
  lastAmount     Int
  userId         Int      @db.UnsignedInt
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fixedexpense_ibfk_1")

  @@index([userId], map: "userId")
}
