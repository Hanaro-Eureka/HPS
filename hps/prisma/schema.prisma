generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id         Int    @id @default(autoincrement()) @db.UnsignedInt
  accountNum String @db.VarChar(31)
  userId     Int    @db.UnsignedInt
  User       User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "account_ibfk_1")

  @@index([userId], map: "userId")
}

model CheckBox {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  userId          Int       @db.UnsignedInt
  receiptIssuedAt DateTime? @db.DateTime(0)
  hasReceipt      DateTime? @db.DateTime(0)
  isIncomeTracked DateTime? @db.DateTime(0)
  User            User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "checkbox_ibfk_1")

  @@index([userId], map: "userId")
}

model Pension {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  userId      Int      @db.UnsignedInt
  amount      Int?
  depositDate DateTime @default(now()) @db.DateTime(0)
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pension_ibfk_1")

  @@index([userId], map: "userId")
}

model Salary {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  userId        Int      @db.UnsignedInt
  amount        Int
  depositDate   DateTime @db.DateTime(0)
  depositorName String?  @db.VarChar(63)
  incomeSource  String?  @db.VarChar(63)
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "salary_ibfk_1")

  @@index([userId], map: "userId")
}

model User {
  id           Int            @id @default(autoincrement()) @db.UnsignedInt
  name         String         @db.VarChar(31)
  loginId      String         @db.VarChar(60)
  password     String         @db.VarChar(60)
  createdAt    DateTime       @default(now()) @db.DateTime(0)
  birthDate    String         @db.VarChar(8)
  businessCode String?        @db.VarChar(6)
  Account      Account[]
  CheckBox     CheckBox[]
  FixedExpense FixedExpense[]
  Pension      Pension[]
  Salary       Salary[]
  uselessSpend uselessSpend[]
}

model uselessSpend {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  userId    Int      @db.UnsignedInt
  category  String?  @db.VarChar(31)
  amount    Int?
  createdAt DateTime @default(now()) @db.DateTime(0)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "uselessspend_ibfk_1")

  @@index([userId], map: "userId")
}

model FixedExpense {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  expenseName    String?  @db.VarChar(20)
  lastIncomeDate DateTime @default(now()) @db.DateTime(0)
  lastAmount     Int
  userId         Int      @db.UnsignedInt
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fixedexpense_ibfk_1")

  @@index([userId], map: "userId")
}
